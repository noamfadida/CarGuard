# Telegram bot token from @BotFather (Telegram: message @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Optional: enables AI relevance re-ranking for users who set /setprofile.
# Without this, matching falls back to keywords/location only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# How often (seconds) to check all sources for new jobs.
POLL_INTERVAL_SECONDS=900

# Max new job messages sent to one user per poll cycle (keeps a burst of
# new postings from flooding a chat all at once).
MAX_JOBS_PER_USER_PER_RUN=10

# Optional overrides — defaults are fine for local/single-instance use.
# JOBBOT_DB_PATH=./data/jobbot.sqlite3
# JOBBOT_SOURCES_PATH=./sources.yaml
# HTTP_TIMEOUT_SECONDS=20
